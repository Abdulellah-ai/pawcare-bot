# Copy to .local/secrets.env (it is git-ignored). Never commit real values.

# Telegram bot (BotFather) and the staff group (supergroup with Topics enabled)
TELEGRAM_BOT_TOKEN=
STAFF_GROUP_ID=

# OpenAI
OPENAI_API_KEY=

# Supabase (project ref + limited database role used by n8n)
SUPABASE_PROJECT_REF=
PAWCARE_DB_HOST=
PAWCARE_DB_ROLE=
PAWCARE_DB_PASSWORD=

# n8n credential ids (created inside n8n) and API access
N8N_CRED_OPENAI_ID=
N8N_CRED_POSTGRES_ID=
N8N_CRED_TELEGRAM_ID=
N8N_BASE_URL=
N8N_API_KEY=

# Dashboard <-> n8n assistant webhook (HMAC-signed)
ASSISTANT_HMAC_SECRET=
ASSISTANT_WEBHOOK_URL=

# Dashboard (Next.js): dashboard/.env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
